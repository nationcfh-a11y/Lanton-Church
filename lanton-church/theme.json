{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1160px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "base", "color": "#FFFDF8", "name": "Warm White" },
				{ "slug": "surface", "color": "#FBF1D7", "name": "Sunlit Cream" },
				{ "slug": "contrast", "color": "#2E2A1C", "name": "Stained-Glass Ink" },
				{ "slug": "contrast-2", "color": "#548C9A", "name": "Window Teal" },
				{ "slug": "primary", "color": "#EAAA38", "name": "Golden Amber" },
				{ "slug": "primary-dark", "color": "#C6881A", "name": "Deep Amber" },
				{ "slug": "muted", "color": "#8C7C61", "name": "Warm Stone" },
				{ "slug": "teal-light", "color": "#9AD2E0", "name": "Sky Teal" },
				{ "slug": "sage", "color": "#7E9E63", "name": "Hill Sage" },
				{ "slug": "sage-light", "color": "#A8B67E", "name": "Light Sage" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" }
			],
			"gradients": [
				{
					"slug": "ink-overlay",
					"name": "Golden Overlay",
					"gradient": "linear-gradient(180deg, rgba(146,96,24,0.2) 0%, rgba(120,76,18,0.5) 100%)"
				},
				{
					"slug": "ink-veil",
					"name": "Amber Veil",
					"gradient": "linear-gradient(180deg, rgba(146,96,24,0.16) 0%, rgba(120,76,18,0.42) 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Serif)",
					"fontFamily": "'Playfair Display', Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "body",
					"name": "Body (Sans)",
					"fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem", "fluid": { "min": "0.85rem", "max": "0.95rem" } },
				{ "slug": "medium", "name": "Medium", "size": "1.1rem", "fluid": { "min": "1.02rem", "max": "1.2rem" } },
				{ "slug": "large", "name": "Large", "size": "1.6rem", "fluid": { "min": "1.3rem", "max": "1.85rem" } },
				{ "slug": "x-large", "name": "X-Large", "size": "3.2rem", "fluid": { "min": "2.3rem", "max": "4rem" } },
				{ "slug": "xx-large", "name": "XX-Large", "size": "4.8rem", "fluid": { "min": "3rem", "max": "6rem" } },
				{ "slug": "huge", "name": "Huge", "size": "8rem", "fluid": { "min": "4rem", "max": "10.5rem" } }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "1 — Tight", "size": "0.75rem" },
				{ "slug": "30", "name": "2 — Small", "size": "1.25rem" },
				{ "slug": "40", "name": "3 — Base", "size": "2rem" },
				{ "slug": "50", "name": "4 — Medium", "size": "3rem" },
				{ "slug": "60", "name": "5 — Large", "size": "4.5rem" },
				{ "slug": "70", "name": "6 — X-Large", "size": "6rem" },
				{ "slug": "80", "name": "7 — Huge", "size": "8rem" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" }
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.12",
					"letterSpacing": "-0.005em"
				},
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-dark)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--sage)",
					"text": "#FFFFFF"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "0.82rem",
					"textDecoration": "none",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "1.05rem", "bottom": "1.05rem", "left": "2.3rem", "right": "2.3rem" } },
				":hover": { "color": { "background": "#A8B67E", "text": "#FFFFFF" } },
				":focus": { "color": { "background": "#A8B67E", "text": "#FFFFFF" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "1.4rem",
					"fontWeight": "600"
				}
			},
			"core/navigation": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "500", "fontSize": "0.95rem" }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)" }
			},
			"core/quote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontStyle": "italic" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-full-width", "title": "Full Width (no title)", "postTypes": ["page"] }
	]
}
